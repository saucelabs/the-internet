<style>
  .custom-select { position: relative; max-width: 20em; margin-bottom: 1em; }
  .custom-select .combo { border: 1px solid #c8c8be; border-radius: 0.5rem; padding: 0.5em 2em 0.5em 0.75em; background: white; cursor: pointer; position: relative; }
  .custom-select .combo::after { content: "\25BE"; position: absolute; right: 0.75em; }
  .custom-select .combo:focus { outline: 2px solid #abe082; }
  .custom-select .listbox { position: absolute; left: 0; right: 0; top: 100%; background: white; border: 1px solid #c8c8be; border-radius: 0.5rem; z-index: 10; }
  .custom-select .listbox[hidden] { display: none; }
  .custom-select .option { padding: 0.4em 0.75em; cursor: pointer; }
  .custom-select .option.current { background: #f3ffcc; }
  .custom-select .option[aria-selected="true"] { font-weight: 700; }
  .custom-select .option[aria-disabled="true"] { color: #999; cursor: not-allowed; }
</style>
<div class="example">
  <h3>Custom Dropdown</h3>
  <p>This looks like a select list, but it is made of <code>div</code>s with ARIA roles. Select-list helpers don't work on it: click it, or focus it and use the arrow keys, Enter and Escape.</p>
  <div id="fruit-label">Fruit</div>
  <div class="custom-select" id="fruit-select">
    <div class="combo" id="fruit-combo" role="combobox" tabindex="0" aria-labelledby="fruit-label" aria-haspopup="listbox" aria-expanded="false" aria-controls="fruit-listbox">Choose a fruit</div>
    <div class="listbox" id="fruit-listbox" role="listbox" aria-labelledby="fruit-label" hidden>
      <div class="option" role="option" id="fruit-apple" data-value="apple" aria-selected="false">Apple</div>
      <div class="option" role="option" id="fruit-banana" data-value="banana" aria-selected="false">Banana</div>
      <div class="option" role="option" id="fruit-cherry" data-value="cherry" aria-selected="false" aria-disabled="true">Cherry (out of stock)</div>
      <div class="option" role="option" id="fruit-mango" data-value="mango" aria-selected="false">Mango</div>
      <div class="option" role="option" id="fruit-orange" data-value="orange" aria-selected="false">Orange</div>
    </div>
  </div>
  <p id="result">Selected: nothing</p>
</div>
<script>
  (function() {
    var combo = document.getElementById('fruit-combo');
    var listbox = document.getElementById('fruit-listbox');
    var options = Array.prototype.slice.call(listbox.querySelectorAll('[role=option]'));
    var current = -1;

    function enabled(option) { return option.getAttribute('aria-disabled') !== 'true'; }

    function setCurrent(index) {
      options.forEach(function(o) { o.classList.remove('current'); });
      current = index;
      if (index >= 0) {
        options[index].classList.add('current');
        combo.setAttribute('aria-activedescendant', options[index].id);
      }
    }

    function open() {
      listbox.hidden = false;
      combo.setAttribute('aria-expanded', 'true');
      var selected = options.findIndex(function(o) { return o.getAttribute('aria-selected') === 'true'; });
      setCurrent(selected >= 0 ? selected : 0);
    }

    function close() {
      listbox.hidden = true;
      combo.setAttribute('aria-expanded', 'false');
      combo.removeAttribute('aria-activedescendant');
      setCurrent(-1);
    }

    function select(option) {
      if (!enabled(option)) return;
      options.forEach(function(o) { o.setAttribute('aria-selected', o === option ? 'true' : 'false'); });
      combo.textContent = option.textContent;
      combo.setAttribute('data-value', option.getAttribute('data-value'));
      document.getElementById('result').textContent = 'Selected: ' + option.getAttribute('data-value');
      close();
      combo.focus();
    }

    function move(step) {
      var i = current;
      do { i = (i + step + options.length) % options.length; } while (!enabled(options[i]));
      setCurrent(i);
    }

    combo.addEventListener('click', function() { listbox.hidden ? open() : close(); });
    options.forEach(function(option) {
      option.addEventListener('click', function() { select(option); });
    });
    combo.addEventListener('keydown', function(event) {
      if (listbox.hidden) {
        if (['ArrowDown', 'ArrowUp', 'Enter', ' '].indexOf(event.key) >= 0) { open(); event.preventDefault(); }
        return;
      }
      if (event.key === 'ArrowDown') move(1);
      else if (event.key === 'ArrowUp') move(-1);
      else if (event.key === 'Enter' || event.key === ' ') select(options[current]);
      else if (event.key === 'Escape') close();
      else return;
      event.preventDefault();
    });
    document.addEventListener('click', function(event) {
      if (!document.getElementById('fruit-select').contains(event.target)) close();
    });
  })();
</script>
