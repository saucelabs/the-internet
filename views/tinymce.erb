<html>
  <head>
    <script src="/js/vendor/tinymce/tinymce.min.js"></script>
    <script>
      tinymce.init({
        selector:'textarea',
        theme: "silver",
        skin: "tinymce-5",
        promotion: false
      });
    </script>
  </head>
  <body>
    <div class="example">
      <h3>An iFrame containing the TinyMCE WYSIWYG Editor</h3>
      <textarea>Your content goes here.</textarea>
    </div>
  </body>
</html>
