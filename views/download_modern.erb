<div class="example">
  <h3>Modern File Download</h3>
  <p>Downloads that don't come from a plain link to a file on the server.</p>

  <h4>Made in the browser</h4>
  <p>
    <button id="blob-download" class="button" type="button">Download a CSV made with a Blob</button>
    <button id="fetch-download" class="button" type="button">Fetch JSON, then save it</button>
    <a id="data-url-download" class="button secondary" href="data:text/plain;charset=utf-8,Hello%20from%20a%20data%20URL%0A" download="hello.txt">Download from a data URL</a>
  </p>
  <p id="download-status" role="status">Nothing downloaded yet</p>

  <h4>Content-Disposition from the server</h4>
  <ul id="disposition-links">
    <li><a href="/download_modern/file/inline">inline.txt</a>: <code>inline</code>, opens in the browser</li>
    <li><a href="/download_modern/file/utf8">résumé.txt</a>: UTF-8 name in <code>filename*</code> (plain <code>filename="resume.txt"</code> as fallback)</li>
    <li><a href="/download_modern/file/spaces">my report 2026.txt</a>: spaces in the name</li>
    <li><a href="/download_modern/file/no_name">no name</a>: <code>attachment</code> without a file name</li>
  </ul>
</div>
<script>
  (function() {
    var status = document.getElementById('download-status');

    function save(blob, name) {
      var url = URL.createObjectURL(blob);
      var link = document.createElement('a');
      link.href = url;
      link.download = name;
      document.body.appendChild(link);
      link.click();
      link.remove();
      setTimeout(function() { URL.revokeObjectURL(url); }, 1000);
      status.textContent = 'Saved ' + name + ' (' + blob.size + ' bytes, ' + blob.type + ')';
    }

    document.getElementById('blob-download').addEventListener('click', function() {
      var csv = 'name,count\napple,3\nbanana,5\n';
      save(new Blob([csv], { type: 'text/csv' }), 'report.csv');
    });

    document.getElementById('fetch-download').addEventListener('click', function() {
      status.textContent = 'Fetching...';
      fetch('/download_modern/file/report.json').then(function(res) {
        var match = /filename="([^"]+)"/.exec(res.headers.get('Content-Disposition') || '');
        return res.blob().then(function(blob) { save(blob, match ? match[1] : 'download.json'); });
      });
    });

    document.getElementById('data-url-download').addEventListener('click', function() {
      status.textContent = 'Saved hello.txt from a data URL';
    });
  })();
</script>
